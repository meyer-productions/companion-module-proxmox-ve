# Nur für den lokalen Smoke-Test (yarn smoke). Das Modul selbst liest diese Datei nicht.
# Kopie als .env anlegen und ausfüllen. .env ist gitignored.

# Ein oder mehrere Nodes desselben Clusters, kommagetrennt (Failover-Reihenfolge)
PVE_HOSTS=192.168.1.11,192.168.1.12
PVE_PORT=8006

# API-Token: <user>@<realm>!<tokenname> und das Secret (UUID)
PVE_TOKEN_ID=companion@pve!companion
PVE_TOKEN_SECRET=

# TLS: fingerprint | verify | insecure
PVE_TLS_MODE=fingerprint
# SHA-256-Fingerprints der Node-Zertifikate, kommagetrennt (yarn smoke zeigt sie an)
PVE_FINGERPRINTS=
